# ==========================================
# Alkaa Frontend - Environment Configuration
# ==========================================

# Backend API URL (Default local development: http://localhost:3000)
VITE_BACKEND_DOMAIN=http://localhost:3000

# Cloudinary Configuration (Used for media & document uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Web Push Notification Public VAPID Key (Must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Ola Maps SDK API Key (Used for geofencing, location viewer, and attendance mapping)
VITE_OLA_API_KEY=your_ola_maps_api_key

# Optional Branding Assets
VITE_ALKAA_LOGO=https://res.cloudinary.com/dwxm42izp/image/upload/v1750777859/logo_icon_m6lcvc.svg

